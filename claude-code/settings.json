{
  "$comment": "Three permission tiers documented in CLAUDE.md §Permissions (mirrors suwappu-db). The deny list is the security floor: add to it, never remove without explicit security review. Wire into a session via the symlinks described in claude-code/README.md (.claude/ is gitignored).",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(cargo fmt:*)",
      "Bash(cargo check:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo deny:*)",
      "Bash(cargo metadata:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(./scripts/check.sh:*)",
      "Bash(./scripts/check-10k.sh:*)",
      "Bash(./scripts/check-crypto-boundary.sh:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(gh pr create:*)",
      "Bash(gh release create:*)",
      "Bash(./scripts/deploy-aws.sh:*)",
      "Bash(aws:*)",
      "Bash(terraform:*)",
      "Bash(npm publish:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git rebase:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform apply:*)",
      "Bash(aws ec2 terminate-instances:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "./claude-code/hooks/fmt-check.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./claude-code/hooks/block-destructive.sh"
          }
        ]
      }
    ]
  }
}

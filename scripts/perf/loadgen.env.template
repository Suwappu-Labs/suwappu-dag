# gsx-loadgen environment file rendered by scripts/perf/render-configs.sh
# during provision. Installed at /etc/gsx/loadgen.env on the loadgen host.
#
# TARGETS — comma-separated <host:port> list. Should be every
# validator's client_listen (port 9091 in the perf-testnet config).
TARGETS=us-east-1:9091,us-west-2:9091,eu-west-1:9091,ap-northeast-1:9091

# RATE — total intents/sec across ALL targets. Round-robins per submit.
# 100 = ~25 per validator. Adjust for stress runs.
RATE=100

# SEED — deterministic RNG so consecutive campaigns are reproducible.
# Bumped per campaign in scripts/perf/compliance-campaign.sh.
SEED=0

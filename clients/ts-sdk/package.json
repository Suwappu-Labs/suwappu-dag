{
  "name": "@suwappu/client",
  "version": "0.2.0",
  "description": "TypeScript client SDK for the suwappu-dag JSON-RPC query API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --experimental-test-coverage test/*.test.ts",
    "docs": "typedoc",
    "clean": "rm -rf dist docs-out"
  },
  "keywords": [
    "suwappu",
    "blockchain",
    "json-rpc",
    "client",
    "sdk"
  ],
  "author": "Suwappu Labs <eng@suwappu.bot>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Suwappu-Labs/suwappu-dag.git",
    "directory": "clients/ts-sdk"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.22.4",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
